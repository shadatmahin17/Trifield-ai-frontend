rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return (!('email' in data) || data.email is string)
        && (!('displayName' in data) || data.displayName is string)
        && (!('bio' in data) || data.bio is string)
        && (!('avatarUrl' in data) || data.avatarUrl is string)
        && (!('searchesCount' in data) || data.searchesCount is int)
        && (!('pdfsCount' in data) || data.pdfsCount is int);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if false;
    }

    match /test/{document} {
      allow get: if true;
    }
  }
}
